# Port for the OpenPrompt proxy server
PORT=3000

# Comma-separated list of origins allowed to call this proxy.
# Leave empty to allow any origin (fine for local dev / file:// usage).
ALLOWED_ORIGIN=http://localhost:5500

# Upstream API keys live HERE now - never in the browser.
# Free SerpAPI key: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Jina reader key (r.jina.ai rejects many keyless requests)
JINA_API_KEY=
