{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "openprompt-proxy",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/generate-outreach.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/generate-outreach",
      "dest": "/api/generate-outreach.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/generate-outreach.js": {
      "maxDuration": 30
    }
  }
}